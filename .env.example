# Copy to .env and fill in. .env is never committed.

# Model provider: any OpenAI-compatible Chat Completions API
OPENAI_BASE_URL=https://api.kimi.com/coding/v1
OPENAI_API_KEY=
MODEL=kimi-k2-7-code

# Postgres (source of truth). Empty = in-memory store, for demos and tests only.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/meatless_proxy

# Redis for BullMQ. Empty = in-memory queue, for demos and tests only.
REDIS_URL=redis://127.0.0.1:6379

# HTTP port for the API, WebSocket and web UI
PORT=3000

# Key used to encrypt stored secrets (32+ random characters)
SECRETS_KEY=

# Public URL of the harness (used for sign-in links, CSRF checks and cookies, and as the address GitLab webhooks
# are registered at: without it they aren't set up), e.g. https://meatless.example.com
PUBLIC_URL=
# Email of the first admin contact (optional)
ADMIN_EMAIL=
# Optional sign-in through an identity provider (set all four, or none)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
# Bearer token for scraping /metrics without an admin session (optional)
METRICS_TOKEN=
# Domain for live previews on their own origin, e.g. preview.meatless.example.com (optional; needs
# PUBLIC_URL, wildcard DNS and a wildcard certificate, with *.<domain> proxied to PREVIEW_PORT)
PREVIEW_DOMAIN=
# The live preview listener. Without PREVIEW_DOMAIN previews are served on this port of the harness's host. 0 = off
PREVIEW_PORT=3001
# Integrations to enable: slack,linear,gitlab (default) or none. Tokens are employee-scoped secrets.
INTEGRATIONS=
# Alerts in #alerts
ALERTS_ENABLED=true
ALERT_PAUSED_MINUTES=30

# ── Runaway protection (defaults; Settings → Limits overrides them per deployment, employee or requester) ──
# Forks at most this deep, children per loop, runs of one employee working at once (more wait in the queue)
LIMIT_MAX_DEPTH=5
LIMIT_MAX_FAN_OUT=20
LIMIT_MAX_CONCURRENT_RUNS=8
# Model calls per run, and minutes of work per run, before it pauses (0 = no wall-clock limit)
MAX_STEPS=60
LIMIT_RUN_WALL_MINUTES=30
# Tokens per employee per UTC day before its new work pauses (0 = no limit). Cost budgets are off unless set.
LIMIT_EMPLOYEE_DAILY_TOKENS=5000000
LIMIT_EMPLOYEE_DAILY_COST_USD=
LIMIT_DEPLOYMENT_DAILY_TOKENS=
LIMIT_DEPLOYMENT_DAILY_COST_USD=
# #alerts gets a warning at this percent of a daily or monthly budget (0 = none)
BUDGET_WARN_PERCENT=80
# Prices in USD per million tokens, over the built-in table (Settings → Pricing wins over this). JSON, or a path to a
# JSON file. Models without a price cost $0 and show "no pricing configured". Example:
# PRICING={"my-model":{"inputPerM":0.6,"cachedInputPerM":0.15,"outputPerM":2.5}}
PRICING=

# ── Code execution (code.run) ──
# The sandbox image (docker/sandbox/Dockerfile); build your own with `docker build -t mp-sandbox docker/sandbox`.
SANDBOX_IMAGE=ghcr.io/nemanjan00/meatless-proxy-sandbox:latest
# Hosts environments and sandboxes may reach through the egress proxy when neither the employee's network setting
# nor the session's project names any, comma-separated (e.g. pypi.org,files.pythonhosted.org). Empty = no network.
DEFAULT_EGRESS=
# Whether an employee's "Direct network (no proxy)" setting gives its sandbox and environments a real, unproxied
# network (unrestricted and not logged). false turns every direct setting into no network.
DOCKER_DIRECT_NETWORK=true
# Prefix of every container and network this deployment makes (and their mp.deployment label). Give each deployment
# on one Docker host its own, e.g. mp-e2e-: it starts with mp-, ends with -, at most 12 characters.
DOCKER_NAME_PREFIX=mp-
