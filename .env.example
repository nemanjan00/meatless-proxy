# Copy to .env and fill in. .env is never committed.

# Model provider: any OpenAI-compatible Chat Completions API
OPENAI_BASE_URL=https://api.kimi.com/coding/v1
OPENAI_API_KEY=
MODEL=kimi-k2-7-code

# Postgres (source of truth). Empty = in-memory store, for demos and tests only.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/meatless_proxy

# Redis for BullMQ. Empty = in-memory queue, for demos and tests only.
REDIS_URL=redis://127.0.0.1:6379

# HTTP port for the API, WebSocket and web UI
PORT=3000

# Key used to encrypt stored secrets (32+ random characters)
SECRETS_KEY=

# Public URL of the harness (used for sign-in links, CSRF checks and cookies, and as the address GitLab webhooks
# are registered at: without it they aren't set up), e.g. https://meatless.example.com
PUBLIC_URL=
# Email of the first admin contact (optional)
ADMIN_EMAIL=
# Optional sign-in through an identity provider (set all four, or none)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
# Bearer token for scraping /metrics without an admin session (optional)
METRICS_TOKEN=
# Domain for live previews on their own origin, e.g. preview.meatless.example.com (optional; needs
# PUBLIC_URL, wildcard DNS and a wildcard certificate, with *.<domain> proxied to PREVIEW_PORT)
PREVIEW_DOMAIN=
# The live preview listener. Without PREVIEW_DOMAIN previews are served on this port of the harness's host. 0 = off
PREVIEW_PORT=3001
# Integrations to enable: slack,linear,gitlab (default) or none. Tokens are employee-scoped secrets.
INTEGRATIONS=
# Alerts in #alerts
ALERTS_ENABLED=true
ALERT_PAUSED_MINUTES=30

# ── Code execution (code.run) ──
# The sandbox image (docker/sandbox/Dockerfile); build your own with `docker build -t mp-sandbox docker/sandbox`.
SANDBOX_IMAGE=ghcr.io/nemanjan00/meatless-proxy-sandbox:latest
# Hosts environments and sandboxes may reach through the egress proxy when neither the employee's network setting
# nor the session's project names any, comma-separated (e.g. pypi.org,files.pythonhosted.org). Empty = no network.
DEFAULT_EGRESS=
