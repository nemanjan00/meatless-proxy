{
  "name": "meatless-proxy",
  "private": true,
  "type": "module",
  "description": "An AI harness that replaces the human meat proxy: AI employees that talk to the whole company.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:deps": "tsx scripts/check-deps.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "check": "npm run check:deps && npm run check:secrets && npm run check:links && npm run lint && npm run typecheck && npm test",
    "dev": "tsx watch packages/server/src/main.ts",
    "start": "tsx packages/server/src/main.ts",
    "migrate": "tsx packages/server/src/migrate.ts",
    "seed": "tsx packages/server/src/seed-cli.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "token": "tsx packages/server/src/token-cli.ts",
    "check:links": "tsx scripts/check-links.ts",
    "eval": "tsx packages/evals/src/cli.ts",
    "import": "tsx packages/server/src/import-cli.ts",
    "export": "tsx packages/server/src/export-cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "bullmq": "^6.3.9",
    "dockerode": "^5.0.1",
    "hono": "^4.13.10",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  }
}
